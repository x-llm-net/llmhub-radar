MARKETPLACE_DATABASE_URL=postgres://llmhub:llmhub@127.0.0.1:55432/llmhub_marketplace
MARKETPLACE_API_INTERNAL_URL=http://127.0.0.1:3010
MARKETPLACE_MANAGEMENT_TOKEN=replace-with-a-long-random-internal-token
RADAR_CREDENTIAL_SECRET=replace-with-at-least-32-random-characters
MARKETPLACE_PROBE_POLL_INTERVAL_MS=5000
MARKETPLACE_PROBE_BATCH_SIZE=20
MARKETPLACE_PROBE_CONCURRENCY=10
MARKETPLACE_CATALOG_REFRESH_INTERVAL_MS=21600000
MARKETPLACE_CATALOG_REFRESH_CONCURRENCY=10
MARKETPLACE_CONFIG_SYNC_POLL_INTERVAL_MS=5000
MARKETPLACE_CONFIG_SYNC_BATCH_SIZE=10
# New API internal endpoint root, for example https://relay.example.com/api/internal/xllm/.
LLMHUB_RELAY_SYNC_URL=
LLMHUB_RELAY_SYNC_TOKEN=
# Local-only traffic adapter. Keep false/unset outside local development.
LLMHUB_ROUTER_FAKE=false
# The request URL normally matches LLMHUB_RELAY_SYNC_URL. Use a different token.
LLMHUB_RELAY_REQUEST_URL=
LLMHUB_RELAY_REQUEST_TOKEN=
MARKETPLACE_LEGACY_PUBLIC_URL=https://llm-hub.store
