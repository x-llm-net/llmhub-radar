# Copy to .env.radar for Docker deployment.
# Do not commit .env.radar.

# Database
DATABASE_URL=http://libsql:8080
DATABASE_AUTH_TOKEN=

# Public URLs
NEXT_PUBLIC_DASHBOARD_URL=https://app.llm-hub.store
NEXT_PUBLIC_URL=https://app.llm-hub.store
NEXT_PUBLIC_STATUS_PAGE_URL=https://llm-hub.store
STATUS_PAGE_URL=http://status-page:3000
AUTH_URL=https://app.llm-hub.store

# Auth
AUTH_SECRET=replace-with-at-least-32-random-characters
NEXTAUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_TRUST_HOST=true
SELF_HOST=true
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email and subscriber notifications
RESEND_API_KEY=
RESEND_FROM=

# Cron/API worker protection
CRON_SECRET=replace-with-random-cron-secret

# Radar credential encryption.
# Generate once for one production database and keep it stable across deployments.
# Example: openssl rand -base64 48
# If this value changes, existing provider Base URLs and API keys cannot be decrypted.
RADAR_CREDENTIAL_SECRET=replace-with-at-least-32-random-characters

# Radar workers
RADAR_CRON_INTERVAL_MS=60000
RADAR_NOTIFICATION_INTERVAL_MS=60000
# Notification workers ignore events created before the worker process started.
# This prevents deploy/restart replay of historical pending notifications.
RADAR_NOTIFICATION_MAX_EVENT_AGE_MS=900000

# Optional service placeholders retained for upstream packages.
NODE_ENV=production
TURBO_ENV_MODE=loose
TINY_BIRD_API_KEY=
TINYBIRD_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UNKEY_API_ID=
UNKEY_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
PROJECT_ID_VERCEL=
TEAM_ID_VERCEL=
VERCEL_AUTH_BEARER_TOKEN=
BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=
OPENPANEL_CLIENT_SECRET=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
FLY_REGION=self-hosted
