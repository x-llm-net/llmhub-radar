# Copy to .env.radar for Docker deployment.
# Do not commit .env.radar.

# Database
DATABASE_URL=http://libsql:8080
DATABASE_AUTH_TOKEN=

# Persistent media storage used by the Dashboard upload API.
# Docker Compose mounts a named volume at this path.
MEDIA_STORAGE_ROOT=/app/data/media

# Public URLs
NEXT_PUBLIC_DASHBOARD_URL=https://app.llm-hub.store
NEXT_PUBLIC_URL=https://app.llm-hub.store
NEXT_PUBLIC_STATUS_PAGE_URL=https://llm-hub.store
NEXT_PUBLIC_MARKETPLACE_API_URL=https://llm-hub.store
NEXT_PUBLIC_MARKETPLACE_URL=https://llm-hub.store
STATUS_PAGE_URL=http://status-page:3000
AUTH_URL=https://app.llm-hub.store

# Marketplace PostgreSQL. The dashboard only uses the public API URL above;
# credentials stay in the Marketplace API and sync processes.
MARKETPLACE_POSTGRES_DB=llmhub_marketplace
MARKETPLACE_POSTGRES_USER=llmhub
MARKETPLACE_POSTGRES_PASSWORD=replace-with-a-long-random-password
MARKETPLACE_DATABASE_URL=postgres://llmhub:replace-with-a-long-random-password@marketplace-postgres:5432/llmhub_marketplace
MARKETPLACE_LEGACY_PUBLIC_URL=https://llm-hub.store
MARKETPLACE_LEGACY_PUBLIC_SLUGS=x-llm,skyhope,autorouter,deepkey
MARKETPLACE_MIN_RANKING_SCORE=80
MARKETPLACE_SYNC_INTERVAL_MS=600000
MARKETPLACE_CLEANUP_INTERVAL_MS=86400000

# Auth
AUTH_SECRET=replace-with-at-least-32-random-characters
NEXTAUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_TRUST_HOST=true
AUTH_DEBUG=false
SELF_HOST=true
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email and subscriber notifications
RESEND_API_KEY=
RESEND_FROM=

# Cron/API worker protection
CRON_SECRET=replace-with-random-cron-secret

# Radar credential encryption.
# Generate once for one production database and keep it stable across deployments.
# Example: openssl rand -base64 48
# If this value changes, existing provider Base URLs and API keys cannot be decrypted.
RADAR_CREDENTIAL_SECRET=replace-with-at-least-32-random-characters

# Radar workers
RADAR_CRON_INTERVAL_MS=60000
RADAR_NOTIFICATION_INTERVAL_MS=60000
# Optional priority pool settings.
# Comma-separated radar pool slugs. Priority pools get one retry for transient
# probe failures by default. Keep this empty unless the pool is operated by us or
# a trusted close partner.
RADAR_PRIORITY_POOL_SLUGS=
RADAR_PRIORITY_PROBE_RETRIES=1
RADAR_PRIORITY_PROBE_RETRY_BACKOFF_MS=1500
# Notification workers ignore events created before the worker process started.
# This prevents deploy/restart replay of historical pending notifications.
RADAR_NOTIFICATION_MAX_EVENT_AGE_MS=900000

# Optional service placeholders retained for upstream packages.
NODE_ENV=production
TURBO_ENV_MODE=loose
TINY_BIRD_API_KEY=
TINYBIRD_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UNKEY_API_ID=
UNKEY_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
PROJECT_ID_VERCEL=
TEAM_ID_VERCEL=
VERCEL_AUTH_BEARER_TOKEN=
BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=
OPENPANEL_CLIENT_SECRET=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
FLY_REGION=self-hosted

RADAR_ADMIN_EMAILS=
