# LLM-Hub production reverse proxy.
# Access logs are intentionally metadata-only: no request body or credentials.

# Direct and custom domains use publicly trusted certificates managed by Caddy.
llm-hub.store, 343246113.xyz {
	log {
		output file /var/log/caddy/llm-hub-access.json {
			roll_size 100MiB
			roll_keep 7
			roll_keep_for 168h
		}
		format filter {
			wrap json
			request>headers>Authorization delete
			request>headers>Cookie delete
			request>headers>Proxy-Authorization delete
			request>headers>X-Api-Key delete
			request>headers>X-Goog-Api-Key delete
			request>headers>X-Auth-Token delete
			request>uri query {
				delete access_token
				delete api_key
				delete key
				delete token
			}
		}
	}
	encode zstd gzip
	reverse_proxy new-api:3000 {
		flush_interval -1
	}
}

# Cloudflare-proxied subdomains use the wildcard Origin Certificate.
*.llm-hub.store {
	log {
		output file /var/log/caddy/llm-hub-access.json {
			roll_size 100MiB
			roll_keep 7
			roll_keep_for 168h
		}
		format filter {
			wrap json
			request>headers>Authorization delete
			request>headers>Cookie delete
			request>headers>Proxy-Authorization delete
			request>headers>X-Api-Key delete
			request>headers>X-Goog-Api-Key delete
			request>headers>X-Auth-Token delete
			request>uri query {
				delete access_token
				delete api_key
				delete key
				delete token
			}
		}
	}
	encode zstd gzip
	tls /etc/caddy/certs/llm-hub.store.pem /etc/caddy/certs/llm-hub.store.key
	reverse_proxy new-api:3000 {
		flush_interval -1
	}
}
